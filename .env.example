# Server-only Cloudflare Pages secrets (never prefix with VITE_)
APP_ORIGIN=https://your-domain.example
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
SHEETS_WEB_APP_URL=https://script.google.com/macros/s/replace/exec
SHEETS_SHARED_SECRET=replace-with-a-long-random-secret
# Bind KV as ORDERS and a Cloudflare rate limiting binding as RATE_LIMITER.
# Optional client analytics configuration must be reviewed before use.
# Enable only after confirming prices, shipping, policies, integrations and tests.
VITE_CHECKOUT_ENABLED=false

# Optional privacy-friendly analytics; leave blank to disable.
VITE_PLAUSIBLE_DOMAIN=
